
// C-Prime implemented feature showcase.

import "example_import.cprime";
import "example_native.cpp";

type DomainType : primitive uint32;
type DomainTuple : (DomainType, DomainType);
type DomainList : DomainType[];
type FixedDomainList : DomainType[3];

struct StructType {
    DomainType domain_value;
    primitive bool primitive_value;
}

enum EnumType {
    ENUM_VALUE_ONE,
    ENUM_VALUE_TWO,
    ENUM_VALUE_THREE
}

function exampleFunction() {
    print("This is an example function.");
}

function examplePrimitiveReturn() -> primitive uint32 {
    return 42;
}

function exampleDomainReturn() -> DomainType {
    return 0;
}

template <type T>
function templateParameterAndReturnExample(T first) -> T {
    return first;
}

template <type T, type U>
function templateMultipleTypesExample(T first, U second) -> T {
    return first;
}

template <type T : primitive char8 | primitive char16 | primitive char32>
function boundedTemplateExample(T v) -> void {
    print(v);
}

@discard
function exampleDiscardedFunction() -> primitive uint32 {
    return 42;
}

function main() {
    println("Welcome to C-Prime!");

    exampleFunction();

    primitive uint32 a = examplePrimitiveReturn();
    
    DomainType b = exampleDomainReturn();

    primitive uint32 c = templateParameterAndReturnExample(123);
    
    primitive uint32 d = templateMultipleTypesExample(123, "abc");
    
    boundedTemplateExample('a');

    exampleDiscardedFunction();

}
