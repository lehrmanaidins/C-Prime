
// C-Prime implemented feature showcase.

import "example_import.cprime";
import "example_native.cpp";

type DomainType : primitive uint32;
type DomainList : DomainType[];
type FixedDomainList : DomainType[3];
type DomainTypeOfDomainType : DomainType;

struct StructType {
    DomainType domain_value;
    primitive bool primitive_value;
}

enum EnumType {
    ENUM_VALUE_ONE,
    ENUM_VALUE_TWO,
    ENUM_VALUE_THREE
}

function exampleFunction() {
    println("This is an example function.");
}

function examplePrimitiveReturn() -> primitive uint32 {
    return 42;
}

function exampleDomainReturn() -> DomainType {
    return 0;
}

template <type T>
function templateParameterAndReturnExample(T first) -> T {
    return first;
}

template <type T, type U>
function templateMultipleTypesExample(T first, U second) {
    println(first);
    println(second);
}

template <type T : primitive char8 | primitive char16 | primitive char32>
function boundedTemplateExample(T v) -> void {
    println(v);
}

template <type T: Character>
function templateUnionExample(T v) -> void {
    println(v);
}

@discard
function exampleDiscardedFunction() -> primitive uint32 {
    return 42;
}

function exampleFunctionContracts(primitive uint32 a) -> primitive uint32 b :
    requires (sizeof(a) == 4);
    ensures (a > 0);
    ensures (b < 100);
{
    primitive uint32 value = a * 2;
    return value;
}

function examplePassByReference(reference<primitive uint32> value) -> void {
    println(value);
}

function exampleReturnByReference(reference<primitive uint32> value) -> reference<primitive uint32> {
    return value;
}

function main() {
    println("Welcome to C-Prime!");

    exampleFunction();

    primitive uint32 a = examplePrimitiveReturn();
    println(a);
    
    DomainType b = exampleDomainReturn();
    println(b);

    primitive uint32 c = templateParameterAndReturnExample(123);
    println(c);
    
    templateMultipleTypesExample(123, "abc");
    
    boundedTemplateExample('a');

    templateUnionExample('a');

    exampleDiscardedFunction();

    primitive uint32 e = exampleFunctionContracts(10);
    println(e);

    reference<primitive uint32> f = reference(a);
    println(f);

    reference<primitive uint32> g = exampleReturnByReference(f);
    println(g);
}
