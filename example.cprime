
function main() {
	
	// Single Line Commnt Example
	
	/*
	 * Multiline Comment Example
	 */
	
	// Immutable Unsignd Integer Variables
    primitive uint8 a = 1;
    primitive uint16 b = 2;
    primitive uint32 c = 3;
    primitive uint32 d = 4;
	
	// Mutable Unsignd Integer Variables
    mutable primitive uint8 e = 1;
    mutable primitive uint16 f = 2;
    mutable primitive uint32 g = 3;
    mutable primitive uint32 h = 4;
	
	// Immutable Character Types
    primitive char8 i = 'a';
    primitive char16 j = 'b';
    primitive char32 k = 'c';
	
	// Mutable Chacter Types
    mutable primitive char8 l = 'a';
    mutable primitive char16 m = 'b';
    mutable primitive char32 n = 'c';
	
	// Immutable and Mutable Boolean
    primitive bool o = false;
    mutable primitive bool p = true;
	
    primitive uint8[3] q = {1, 2, 3}; // Array
    (primitive uint8, primitive float32) r = (1, 2.0); // Tuple

    type ExampleType : primitive uint8; // Primitive Domain Type Definition
    type ExampleTuple : (ExampleType, ExampleType); // Tuple Type Definition
    type ExampleArray : ExampleType[]; // Array Type Definition

    ExampleType s = 1.0; // Using Primitive Domain Type
    ExampleTuple t = (1, 2); // Using Tuple Domain Type
    ExampleArray[3] u = {1, 2, 3}; // Using Array Domain Type

    struct ExampleStruct {
        ExampleType value1;
        ExampleType value2;
    };

    ExampleStruct example_struct = {
        value1 = 1,
        value2 = 2
    };

    enum ExampleEnum {
        EXAMPLE1,
        EXAMPLE2,
        EXAMPLE3
    };
}
