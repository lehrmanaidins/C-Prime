type Id : primitive uint32;
type IdPair : (Id, Id);
type IdList : Id[];

struct Record {
    Id id;
    primitive bool enabled;
};

enum State {
    STARTING,
    RUNNING,
    STOPPED
};

function main() {
    Id id = 7;
    IdPair pair = (1, 2);
    IdList[3] ids = {1, 2, 3};
    Record record = {
        id = 8,
        enabled = true
    };
    State state = State::RUNNING;
    println(id);
}