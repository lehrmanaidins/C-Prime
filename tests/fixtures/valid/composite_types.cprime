
type UnFixedLengthArrayType : primitive uint32[];
type FixedLengthArrayType : primitive uint32[3];

function main() {
    UnFixedLengthArrayType[3] unfixed_length_array = {1, 2, 3};
    FixedLengthArrayType fixed_length_array = {4, 5, 6};

    println(unfixed_length_array);
    println(fixed_length_array);
}