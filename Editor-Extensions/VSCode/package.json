{
  "name": "c-prime-syntax",
  "displayName": "C-Prime Language Support",
  "description": "Syntax highlighting and editor intelligence for C-Prime files",
  "publisher": "Hydranet",
  "version": "0.2.0",
  "keywords": [ "cprime", "c-prime", "hprime", "transpiler" ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lehrmanaidins/C-Prime"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "npx @vscode/vsce package",
    "validate": "node --check extension.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "cprime",
        "aliases": [
          "C-Prime",
          "cprime"
        ],
        "extensions": [
          ".cprime",
          ".hprime"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cprime",
        "scopeName": "source.cprime",
        "path": "./syntaxes/cprime.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "C-Prime",
      "properties": {
        "cprime.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable C-Prime syntax diagnostics."
        }
      }
    },
    "snippets": [
      {
        "language": "cprime",
        "path": "./snippets/cprime.code-snippets"
      }
    ]
  }
}
